# Telegram
BOT_TOKEN=your_telegram_bot_token

# Database
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database

# AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=your_ai_model

# Application
LOG_LEVEL=INFO
TIMEZONE=Europe/Berlin

# Moderation
DEFAULT_MODERATION_ENABLED=true
DEFAULT_AI_ANSWERS_ENABLED=true
DEFAULT_STRICTNESS=medium
DEFAULT_MODERATION_ACTION=warn
DEFAULT_WARNING_THRESHOLD=3

# Context and limits
MAX_CONTEXT_MESSAGES=100
MAX_MESSAGE_LENGTH=4000
AI_TIMEOUT_SECONDS=30

# Summaries
DAILY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_ENABLED=true
DAILY_SUMMARY_HOUR=21
WEEKLY_SUMMARY_DAY=sunday
WEEKLY_SUMMARY_HOUR=20
